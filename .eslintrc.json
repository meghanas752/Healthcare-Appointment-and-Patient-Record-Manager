{
  "env": {
    "node": true,
    "browser": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "off"
  },
  "ignorePatterns": [
    "coverage/",
    "node_modules/",
    "src/web/public/**/*.js"
  ]
}
